# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.*
!.env.example

# DB backup dumps — contain PII (member emails, push subs, etc).
# Backup script (scripts/_backup-db-*.ts) is committed; outputs are not.
/scripts/_backups/

# OpenNext Cloudflare build output — regenerated on every `cf:build` and
# on every Cloudflare Workers Build CI run. Committing it would bloat the
# repo with thousands of bundled files and conflict on every deploy.
/.open-next/
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# Throwaway probes from content/audit sessions — REST dumps, one-off scripts,
# scraped HTML, id lists. They accumulate at the repo root and are worthless a
# day later, but `git add -A` would happily commit them.
#
# This is not only tidiness: a 208-byte `_key.txt` was sitting here untracked,
# exactly the shape of a service-role token. One careless `add -A` publishes a
# credential to a public repo. Ignoring the pattern makes that impossible.
# Delete the file itself too — ignoring hides it, it does not remove it.
/_*.json
/_*.py
/_*.txt
/_*.html
/_dumps/
/.tmp/

# Same, from the pre-underscore era.
/full.json
/lu.json
/pillar.json
/sw.json
/vl.json
/pcount.txt
